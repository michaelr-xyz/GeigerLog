# GeigerLog Custom Configuration file "custom.cfg"
#
# This is a convenience option. You don't need this file, and can delete it, and do
# all your configuration in file "geigerlog.cfg".
#
# However, it is recommended to instead keep the file "geigerlog.cfg" unchanged, and only
# adapt this file "custom.cfg" to your needs.
#
# When this file is named "custom.cfg" and is residing in folder "gconfig" it will be
# processed right after the file "geigerlog.cfg". Anything named here will overwrite
# any previous setting of that same name done in "geigerlog.cfg".
#
# Required is:  the section name in square parenthesis, followed by those parameters of
# this section you wish to redefine. EXAMPLE:  To activate a GMC device, and have it
# collect data to the variables CPM and CPS (instead of the default CPM1st and CPS1st),
# uncomment - aka delete character '#' - in the next three lines:
#[GMC_Device]
#GMC_Activation = yes
#GMC_Variables = CPM, CPS
#
#######################################################################################

[Graphic]
# VARIABLES: CPM,  CPS,     CPM1st,      CPS1st, CPM2nd, CPS2nd,  CPM3rd, CPS3rd, Temperature, Pressure, Humidity, Xtra
# Default  = blue, magenta, deepskyblue, violet, cyan, #9b59b6, brown,  orange, red,         black,    green,  #00ff00
linecolor  = blue, magenta, deepskyblue, violet, cyan, #9b59b6, brown,  orange, red,         black,    green,  #00ff00


[GMC_Device]
GMC_Activation = yes
GMC_Variables  = auto
# GMC_Variables  = CPM, CPS



# [RadProDevice]
# RadProActivation        = yes
# RadProVoltageDefault    = auto
# RadProHVControl         = auto
# RadProVariables         = CPM3rd, CPS3rd, Temp, Press, Humid

[Spectro]
# CalibLines =
#     0, 0,           (Zero)
#      , 17,          Am-241
#      , 26.3,        Am-241
#      , 30.309,      Ag-108
#      , 32,          Cs-137
#      , 47,          Rn-222
#      , 3333.333,    Fantasy

CalibLinesCustom =
     , 3333.333,    Fantasy


# [GammaScoutDevice]
# GSActivation  = yes

[IOTDevice]
IOTActivation   = yes
IOTClientTasmotaSMR = y,     geigerlog/cmnd/tasmotaSMR/Status,   10,           CPM3rd, CPS3rd, Temp, Press, Humid, Xtra
IOTClientTasmotaPL4 = y,     geigerlog/cmnd/tasmotaPL4/Status,   10,           CPM, CPM2nd, CPS2nd,

[Comment]
CommentCPM    = Volt AC

CommentCPM2nd = Current mA
CommentCPS2nd = Power W

CommentCPM3rd = Cnsmptn MWh
CommentCPS3rd = Feed MWh

CommentTemp   = PowerTtl W
CommentPress  = PowerL1  W
CommentHumid  = PowerL2  W
CommentXtra   = PowerL3  W

