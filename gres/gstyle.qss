QLineEdit {
    /* background-color: #ffffdd; */
    background-color: white;
}

QTextEdit{
    background-color: #fdfdff;
}

QPlainTextEdit{
    /* background-color: #afa; */
    background-color: #fdfdff;
}

QTextBrowser{
    background-color: #fdfdff;
}

QDialog{
    /* background-color: #fdf; */
    background-color: #efefef;
}

QFileDialog{
    /* background-color: #fea; */
    background-color: #efefef;
    /* color: purple; */
}

QInputDialog {
    /* background-color: #afa; */
    background-color: #efefef;
}

QListWidget {
    color: #000;
    background-color: #fdfdff;
}

/* scheint nicht änderbar zu sein??? */
